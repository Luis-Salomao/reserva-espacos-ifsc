{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Entradas além das detectadas pelos plugins (vite, vitest/bun, etc.).
  // Caminhos que ainda não existem: src/server (T5), drizzle.config.ts (T4), cli (T7).
  "entry": [
    "src/routes/**/*.{ts,tsx}",
    "src/server/**/*.ts",
    "drizzle.config.ts",
    "cli/**/*.ts",
    "test/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "cli/**/*.ts", "test/**/*.ts", "*.ts"],
  "ignore": [
    // Primitivos shadcn e utilitários do scaffold: usados pelas telas da Fase 1+.
    "src/components/ui/**",
    "src/lib/utils.ts",
    // Substituído por src/infra/env.ts na Task 4.
    "src/env.ts"
  ],
  "ignoreDependencies": [
    // Referenciados apenas por CSS (@import / @plugin em src/styles.css), que o knip não segue.
    "tailwindcss",
    "tw-animate-css",
    "@tailwindcss/typography",
    // Usados pelos primitivos shadcn (ignorados acima) e telas das próximas fases.
    "class-variance-authority",
    "clsx",
    "tailwind-merge",
    "lucide-react",
    "radix-ui",
    // Formulários (Fase 1+) e validação de env/entrada (Task 4).
    "@tanstack/react-form",
    "@t3-oss/env-core",
    "zod"
  ],
  // Binário instalado fora do bun (winget/CI); chamado pelo script `secrets`.
  "ignoreBinaries": ["betterleaks"]
}
