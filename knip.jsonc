{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Entradas além das detectadas pelos plugins (vite, vitest/bun, etc.).
  "entry": [
    "src/routes/**/*.{ts,tsx}",
    "src/server/**/*.ts",
    "drizzle.d1.config.ts",
    // Resolvido via alias #db-client no build cloudflare.
    "src/infra/db/client.cloudflare.ts",
    "cli/**/*.ts",
    "test/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "cli/**/*.ts", "test/**/*.ts", "*.ts"],
  "ignore": [
    // Primitivos shadcn: usados pelas telas da Fase 1+.
    "src/components/ui/**"
  ],
  "ignoreDependencies": [
    // Formulários (Fase 1+).
    "@tanstack/react-form"
  ],
  // Binário instalado fora do bun (winget/CI); chamado pelo script `secrets`.
  "ignoreBinaries": ["betterleaks"]
}
