{
  "name": "reserva-espacos-ifsc",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4"
  },
  "bin": {
    "reserva-espacos": "cli/index.ts"
  },
  "imports": {
    "#/*": "./src/*",
    "#db-client": "./src/infra/db/client.local.ts"
  },
  "scripts": {
    "dev": "bunx --bun vite dev --port 3000",
    "build:local": "bunx --bun vite build && bun run scripts/copy-migrations.ts",
    "build:cf": "DEPLOY_TARGET=cloudflare vite build",
    "build": "bun run build:local",
    "start:local": "NODE_ENV=production bun run cli/check-env.ts && NODE_ENV=production MIGRATIONS_DIR=.output/drizzle bun .output/server/index.mjs",
    "dev:cf": "DEPLOY_TARGET=cloudflare CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite dev",
    "preview:cf": "bun run build:cf && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev",
    "deploy:cf": "bun run cf:check && bun run build:cf && wrangler deploy",
    "cf:check": "bun run cli/check-wrangler.ts",
    "cf:types": "wrangler types --strict-vars=false",
    "prepare": "lefthook install",
    "secrets": "betterleaks git . --redact",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "deps": "depcruise src cli",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "bun run lint && bun run typecheck && bun run knip && bun run deps && bun run test:coverage && bun run secrets",
    "lighthouse": "lhci autorun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run cli/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:migrate:d1:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate:d1:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "db:studio:d1": "drizzle-kit studio --config=drizzle.d1.config.ts",
    "cli": "bun run cli/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-query-devtools": "5.105.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45",
    "fast-xml-parser": "5",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260610-beta",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@happy-dom/global-registrator": "21.0.4",
    "@lhci/cli": "0.15.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31",
    "knip": "6.44.1",
    "lefthook": "^2.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "tslib": "2.9.1"
  }
}
