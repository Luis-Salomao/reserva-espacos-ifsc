# Copie para .env (alvo local e comandos do CLI). Nunca versione valores reais.
#
# Cloudflare: as variáveis do Worker ficam em wrangler.jsonc ("vars"). Um .dev.vars (opcional,
# só para `wrangler dev`) deve conter APENAS TIMEZONE e/ou PUBLIC_READ. Nunca coloque nele
# DEPLOY_TARGET=local nem CLOUDFLARE_*: seriam injetados no Worker.

# Alvo de execução: "local" (Bun + arquivo SQLite) ou "cloudflare" (Workers + D1).
DEPLOY_TARGET=local

# Caminho do arquivo SQLite. Obrigatório quando DEPLOY_TARGET=local.
DATABASE_PATH=./data/app.sqlite

# Fuso horário usado para exibir horários. Padrão: America/Sao_Paulo.
TIMEZONE=America/Sao_Paulo

# Leitura pública da agenda sem login (true/false). Padrão: true.
PUBLIC_READ=true

# Expediente da agenda (HH:MM): só se reserva entre a abertura e o fechamento. Padrão: 06:00 e 23:00.
AGENDA_OPENS_AT=06:00
AGENDA_CLOSES_AT=23:00

# Somente para `bun run db:studio:d1` (inspeção do D1 remoto). Ficam no .env, nunca no .dev.vars.
# Use token com escopo mínimo.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Pasta das migrações SQL (opcional). Padrão: drizzle/ na raiz do repositório.
# Defina ao rodar o servidor empacotado (.output/), onde o caminho relativo muda.
# MIGRATIONS_DIR=

# Senhas: algoritmo "scrypt" (padrão) ou "pbkdf2" (100 000 iterações; use se o scrypt estourar o
# limite de CPU do plano gratuito do Workers). Hashes antigos continuam válidos e são regravados
# no próximo login.
# PASSWORD_HASH=scrypt
# Custo do scrypt (potência de 2 entre 1024 e 65536). Padrão: 16384.
# PASSWORD_SCRYPT_N=16384
# Segredo opcional aplicado (HMAC) antes do hash. Em Cloudflare use `wrangler secret put
# PASSWORD_PEPPER`. Trocar o valor invalida TODAS as senhas existentes. Nunca versione.
# PASSWORD_PEPPER=

# Atributo Secure do cookie de sessão: "auto" (padrão: Secure, exceto em http://localhost e
# http://127.0.0.1), "true" (sempre) ou "false" (nunca). Use false só em rede local sem HTTPS.
# COOKIE_SECURE=auto

# Origem pública quando há proxy reverso com TLS (ex.: https://reservas.campus.edu.br; sem caminho).
# Define o Origin aceito nos POST e o Secure do cookie (https => Secure). Vazia: usa a requisição.
# PUBLIC_ORIGIN=
