{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reserva-espacos-ifsc",
  "main": "./src/worker.ts",
  // Habilite "* * * * *" somente após configurar e-mail e secrets; veja README.
  "triggers": { "crons": ["* * * * *"] },
  // Limitada pelo workerd local (wrangler dev): datas além da suportada pelo binário falham.
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reserva-espacos",
      "database_id": "f9201b02-2d51-4d7a-9ebb-ec1b1ab3ba87",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "DEPLOY_TARGET": "cloudflare",
    "TIMEZONE": "America/Sao_Paulo",
    "PUBLIC_READ": "true",
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "Reservas IFSC <reservas@mail.luissalomao.dev>",
    "PUBLIC_ORIGIN": "https://reservas-ifsc.luissalomao.dev"
  }
}
